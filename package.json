{
  "name": "hiring-workflow-scenario-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only hiring workflow scenario simulation with deterministic evidence receipts.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:focused": "vitest run tests/acceptance tests/domain tests/api",
    "test:accessibility": "vitest run tests/accessibility",
    "test:security": "vitest run tests/security",
    "test:recovery": "vitest run tests/recovery",
    "test:mutation": "vitest run tests/mutation",
    "control:critical": "vitest run tests/mutation/critical-validator.test.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run audit:prod && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.62.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.2.12",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
